#!/usr/bin/env bash
# General-purpose progress CLI for Mandara's built-in `progress` plugin.
# Any script, build or agent can report here; the bar chip is shared.
set -euo pipefail

MANDARA="${MANDARA_BIN:-mandara}"
ID="${TASK_ID:-task}"

usage() {
  cat <<'EOF'
Usage: task-progress [-i ID] <command> [args...]

  start "Label"               begin a task (indeterminate running light)
  set <0..100> [label]        set progress
  step "3/7"                  change only the label, keeping progress
  done ["message"]            finish (solid green light)
  fail ["message"]            fail (solid red light)
  reset                       remove the task from the bar
  list                        print every task as JSON
  run "Label" -- cmd…         wrap any command with start/done/fail

The default id is "task"; use -i ID or TASK_ID=ID for another task.
Examples:
  task-progress -i build start "Compiling"
  task-progress -i build set 40 "Compiling: 2/5"
  task-progress -i build done "All green"
  task-progress -i verify run "Running tests" -- cargo test --workspace
EOF
}

die() { printf 'task-progress: %s\n' "$*" >&2; exit 2; }

while [[ "${1:-}" == "-i" ]]; do
  (($# >= 2)) || die "-i needs an id"
  ID="$2"
  shift 2
done

# One shell call and one jq call; `first(...)` replaces the head pipeline.
current_percent() {
  local reply
  reply="$("$MANDARA" msg --json progress list)" || die "cannot reach the shell at '$MANDARA'"
  jq -er --arg id "$ID" 'first(.data[] | select(.id == $id) | (.percent // 0) | floor)' <<<"$reply" || die "no task '$ID'"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  start)
    "$MANDARA" msg progress start "$ID" "${1:-Task}" >/dev/null
    ;;
  set)
    value="${1:-}"
    [[ "$value" =~ ^[0-9]+$ ]] || die "percent must be 0..100"
    value=$((10#$value))
    ((value >= 0 && value <= 100)) || die "percent must be 0..100"
    args=("$MANDARA" msg progress set "$ID" "$value")
    (($# >= 2)) && args+=("$2")
    "${args[@]}" >/dev/null
    ;;
  step)
    pct="$(current_percent)"
    "$MANDARA" msg progress set "$ID" "$pct" "${1:-}" >/dev/null
    ;;
  done)
    "$MANDARA" msg progress done "$ID" "${1:-Done}" >/dev/null
    ;;
  fail)
    "$MANDARA" msg progress fail "$ID" "${1:-Failed}" >/dev/null
    ;;
  reset)
    "$MANDARA" msg progress remove "$ID" >/dev/null 2>&1 || true
    ;;
  list)
    "$MANDARA" msg --json progress list | jq -c '.data'
    ;;
  run)
    label="${1:-Task}"
    shift || true
    [[ "${1:-}" == "--" ]] && shift || true
    (($#)) || die "run needs a command after --"
    "$MANDARA" msg progress start "$ID" "$label" >/dev/null
    finished=0
    finish() {
      local rc=$?
      trap - EXIT INT TERM
      if ((rc == 0 && finished == 1)); then
        "$MANDARA" msg progress done "$ID" "OK" >/dev/null || true
      else
        "$MANDARA" msg progress fail "$ID" "Failed ($rc)" >/dev/null || true
      fi
      exit "$rc"
    }
    trap finish EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    "$@" || exit $?
    finished=1
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    die "unknown command: $cmd"
    ;;
esac
